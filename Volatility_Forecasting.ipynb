     "text": [
      "[forecast.py] Data and results will be saved under: /Users/name/volatility-forecast\n",
      "\n",
      "=== CAC 40 (^FCHI) ===\n",
      "Loaded 2992 daily returns from 2015-01-05 to 2026-09-11\n",
      "GARCH(1,1):  AIC=8239.43  BIC=8269.45  LogL=-4114.72\n",
      "EGARCH(1,1): AIC=8238.16  BIC=8268.18  LogL=-4114.08\n",
      "Running rolling backtest (window=1000, horizon=250)... this may take a minute.\n",
      " model         AIC         BIC  backtest_QLIKE  backtest_MSE\n",
      " GARCH 8239.432008 8269.450494        1.602565      3.158160\n",
      "EGARCH 8238.160641 8268.179128        1.597224      3.084002\n",
      "\n",
      "=== S&P 500 (^GSPC) ===\n",
      "Loaded 2938 daily returns from 2015-01-05 to 2026-09-10\n",
      "GARCH(1,1):  AIC=7380.94  BIC=7410.87  LogL=-3685.47\n",
      "EGARCH(1,1): AIC=7395.90  BIC=7425.83  LogL=-3692.95\n",
      "Running rolling backtest (window=1000, horizon=250)... this may take a minute.\n",
      " model         AIC         BIC  backtest_QLIKE  backtest_MSE\n",
      " GARCH 7380.943199 7410.870620        1.606376      1.346753\n",
      "EGARCH 7395.903469 7425.830891        1.618886      1.354602\n"
     ]
    }
   ],
   "source": [
    "\"\"\"\n",
    "Volatility Forecasting: CAC 40 vs S&P 500 (GARCH vs EGARCH)\n",
    "=============================================================\n",
    "\n",
    "Downloads daily price history for the CAC 40 (^FCHI) and S&P 500 (^GSPC),\n",
    "computes log returns, fits GARCH(1,1) and EGARCH(1,1) models, runs a\n",
    "rolling-window one-step-ahead volatility backtest, and compares the two\n",
    "models on forecast accuracy (QLIKE, MSE) and fit (AIC/BIC).\n",
    "\n",
    "Usage\n",
    "-----\n",
    "    python forecast.py                     # both indices, default params\n",
    "    python forecast.py --tickers ^FCHI     # CAC 40 only\n",
    "    python forecast.py --start 2015-01-01 --window 1000 --horizon 250\n",
    "\n",
    "Outputs\n",
    "-------\n",
    "    results/<ticker>_summary.csv           model comparison table\n",
    "    results/<ticker>_volatility.png        realized vs forecast volatility\n",
    "    results/<ticker>_returns.png           return series (volatility clustering)\n",
    "\"\"\"\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "import argparse\n",
    "import warnings\n",
    "from dataclasses import dataclass\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import yfinance as yf\n",
    "from arch import arch_model\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "TICKERS = {\n",
    "    \"^FCHI\": \"CAC 40\",\n",
    "    \"^GSPC\": \"S&P 500\",\n",
    "}\n",
    "\n",
    "import os\n",
    "\n",
    "\n",
    "def _resolve_base_dir() -> Path:\n",
    "    \"\"\"\n",
    "    Pick a writable base directory for data/results.\n",
    "\n",
     \"\"\"\n",
    "    cwd = Path.cwd()\n",
    "    if cwd == Path(cwd.anchor) or not os.access(cwd, os.W_OK):\n",
    "        base = Path.home() / \"volatility-forecast\"\n",
    "        base.mkdir(parents=True, exist_ok=True)\n",
    "        return base\n",
    "    return cwd\n",
    "\n",
    "\n",
    "BASE_DIR = _resolve_base_dir()\n",
    "RESULTS_DIR = BASE_DIR / \"results\"\n",
    "DATA_DIR = BASE_DIR / \"data\"\n",
    "print(f\"[forecast.py] Data and results will be saved under: {BASE_DIR}\")\n",
    "\n",
    "\n",
    "# --------------------------------------------------------------------------- #\n",
    "# Data\n",
    "# --------------------------------------------------------------------------- #\n",
    "def download_prices(ticker: str, start: str, end: str | None = None) -> pd.Series:\n",
    "    \"\"\"Download adjusted close prices and cache them locally as CSV.\"\"\"\n",
    "    DATA_DIR.mkdir(exist_ok=True)\n",
    "    cache_path = DATA_DIR / f\"{ticker.replace('^', '')}.csv\"\n",
    "\n",
    "    if cache_path.exists():\n",
    "        cached = pd.read_csv(cache_path, index_col=0, parse_dates=True)\n",
    "        prices = cached.iloc[:, 0]  # always take the first column, whatever it's named\n",
    "    else:\n",
    "        df = yf.download(ticker, start=start, end=end, auto_adjust=True, progress=False)\n",
    "        if df.empty:\n",
    "            raise ValueError(f\"No data returned for {ticker}. Check the ticker or your connection.\")\n",
    "\n",
    "        close = df[\"Close\"]\n",
    "        # Newer yfinance versions return MultiIndex columns even for a single\n",
    "        # ticker, so df[\"Close\"] can come back as a 1-column DataFrame rather\n",
    "        # than a Series. Force it down to a plain Series either way.\n",
    "        if isinstance(close, pd.DataFrame):\n",
    "            close = close.iloc[:, 0]\n",
    "        close.name = \"Close\"\n",
    "\n",
    "        prices = close\n",
    "        prices.to_frame(name=\"Close\").to_csv(cache_path)\n",
    "\n",
    "    return prices.dropna()\n",
    "\n",
    "\n",
    "def compute_log_returns(prices: pd.Series) -> pd.Series:\n",
    "    \"\"\"Percentage log returns, scaled by 100 (standard convention for GARCH fitting).\"\"\"\n",
    "    if isinstance(prices, pd.DataFrame):\n",
    "        prices = prices.iloc[:, 0]\n",
    "    returns = 100 * np.log(prices / prices.shift(1))\n",
    "    return returns.dropna()\n",
    "\n",
    "\n",
    "# --------------------------------------------------------------------------- #\n",
    "# Models\n",
    "# --------------------------------------------------------------------------- #\n",
    "@dataclass\n",
    "class ModelResult:\n",
    "    name: str\n",
    "    aic: float\n",
    "    bic: float\n",
    "    log_likelihood: float\n",
    "\n",
    "\n",
    "def fit_volatility_model(returns: pd.Series, vol: str, dist: str = \"t\") -> tuple:\n",
    "    \"\"\"Fit a GARCH(1,1) or EGARCH(1,1) model. vol in {'GARCH', 'EGARCH'}.\"\"\"\n",
    "    model = arch_model(returns, mean=\"Constant\", vol=vol, p=1, q=1, dist=dist)\n",
    "    fitted = model.fit(disp=\"off\")\n",
    "    result = ModelResult(\n",
    "        name=vol,\n",
    "        aic=fitted.aic,\n",
    "        bic=fitted.bic,\n",
    "        log_likelihood=fitted.loglikelihood,\n",
    "    )\n",
    "    return fitted, result\n",
    "\n",
    "\n",
    "# --------------------------------------------------------------------------- #\n",
    "# Rolling-window backtest\n",
    "# --------------------------------------------------------------------------- #\n",
    "def rolling_backtest(returns: pd.Series, vol: str, window: int, horizon: int, dist: str = \"t\") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Walk-forward one-step-ahead volatility forecast.\n",
    "\n",
    "    At each step, fit the model on the last `window` observations and\n",
    "    forecast next-day conditional variance. Compare against the realized\n",
    "    squared return (a standard, if noisy, proxy for realized variance).\n",
    "    \"\"\"\n",
    "    n = len(returns)\n",
    "    start_idx = n - horizon\n",
    "    if start_idx < window:\n",
    "        raise ValueError(\"Not enough data for the requested window/horizon combination.\")\n",
    "\n",
    "    forecast_variance = []\n",
    "    dates = []\n",
    "\n",
    "    for t in range(start_idx, n):\n",
    "        train = returns.iloc[t - window : t]\n",
    "        model = arch_model(train, mean=\"Constant\", vol=vol, p=1, q=1, dist=dist)\n",
    "        fitted = model.fit(disp=\"off\")\n",
    "        fc = fitted.forecast(horizon=1, reindex=False)\n",
    "        forecast_variance.append(fc.variance.values[-1, 0])\n",
    "        dates.append(returns.index[t])\n",
    "\n",
    "    realized_variance = returns.iloc[start_idx:n].values ** 2\n",
    "\n",
    "    out = pd.DataFrame(\n",
    "        {\n",
    "            \"date\": dates,\n",
    "            \"forecast_variance\": forecast_variance,\n",
    "            \"realized_variance\": realized_variance,\n",
    "        }\n",
    "    ).set_index(\"date\")\n",
    "    return out\n",
    "\n",
    "\n",
    "def qlike(realized: np.ndarray, forecast: np.ndarray) -> float:\n",
    "    \"\"\"QLIKE loss — standard asymmetric loss function for variance forecast evaluation.\"\"\"\n",
    "    ratio = realized / forecast\n",
    "    return float(np.mean(ratio - np.log(ratio) - 1))\n",
    "\n",
    "\n",
    "def mse(realized: np.ndarray, forecast: np.ndarray) -> float:\n",
    "    return float(np.mean((realized - forecast) ** 2))\n",
    "\n",
    "\n",
    "# --------------------------------------------------------------------------- #\n",
    "# Plots\n",
    "# --------------------------------------------------------------------------- #\n",
    "def plot_returns(returns: pd.Series, name: str, out_path: Path) -> None:\n",
    "    plt.figure(figsize=(10, 4))\n",
    "    plt.plot(returns.index, returns.values, linewidth=0.6)\n",
    "    plt.title(f\"{name} — Daily Log Returns (%) — Volatility Clustering\")\n",
    "    plt.xlabel(\"Date\")\n",
    "    plt.ylabel(\"Log return (%)\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(out_path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_volatility(bt_garch: pd.DataFrame, bt_egarch: pd.DataFrame, name: str, out_path: Path) -> None:\n",
    "    plt.figure(figsize=(10, 4))\n",
    "    plt.plot(bt_garch.index, np.sqrt(bt_garch[\"realized_variance\"]), label=\"Realized volatility (|return| proxy)\", alpha=0.6)\n",
    "    plt.plot(bt_garch.index, np.sqrt(bt_garch[\"forecast_variance\"]), label=\"GARCH(1,1) forecast\", linewidth=1.2)\n",
    "    plt.plot(bt_egarch.index, np.sqrt(bt_egarch[\"forecast_variance\"]), label=\"EGARCH(1,1) forecast\", linewidth=1.2)\n",
    "    plt.title(f\"{name} — One-Step-Ahead Volatility Forecast: GARCH vs EGARCH\")\n",
    "    plt.xlabel(\"Date\")\n",
    "    plt.ylabel(\"Volatility (%)\")\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(out_path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "# --------------------------------------------------------------------------- #\n",
    "# Pipeline\n",
    "# --------------------------------------------------------------------------- #\n",
    "def run(ticker: str, start: str, window: int, horizon: int, dist: str) -> None:\n",
    "    name = TICKERS.get(ticker, ticker)\n",
    "    print(f\"\\n=== {name} ({ticker}) ===\")\n",
    "\n",
    "    prices = download_prices(ticker, start=start)\n",
    "    returns = compute_log_returns(prices)\n",
    "    print(f\"Loaded {len(returns)} daily returns from {returns.index.min().date()} to {returns.index.max().date()}\")\n",
    "\n",
    "    RESULTS_DIR.mkdir(exist_ok=True)\n",
    "    tag = ticker.replace(\"^\", \"\")\n",
    "\n",
    "    plot_returns(returns, name, RESULTS_DIR / f\"{tag}_returns.png\")\n",
    "\n",
    "    # Full-sample fit: compare AIC/BIC\n",
    "    _, garch_fit = fit_volatility_model(returns, vol=\"GARCH\", dist=dist)\n",
    "    _, egarch_fit = fit_volatility_model(returns, vol=\"EGARCH\", dist=dist)\n",
    "\n",
    "    print(f\"GARCH(1,1):  AIC={garch_fit.aic:.2f}  BIC={garch_fit.bic:.2f}  LogL={garch_fit.log_likelihood:.2f}\")\n",
    "    print(f\"EGARCH(1,1): AIC={egarch_fit.aic:.2f}  BIC={egarch_fit.bic:.2f}  LogL={egarch_fit.log_likelihood:.2f}\")\n",
    "\n",
    "    # Rolling backtest\n",
    "    print(f\"Running rolling backtest (window={window}, horizon={horizon})... this may take a minute.\")\n",
    "    bt_garch = rolling_backtest(returns, vol=\"GARCH\", window=window, horizon=horizon, dist=dist)\n",
    "    bt_egarch = rolling_backtest(returns, vol=\"EGARCH\", window=window, horizon=horizon, dist=dist)\n",
    "\n",
    "    plot_volatility(bt_garch, bt_egarch, name, RESULTS_DIR / f\"{tag}_volatility.png\")\n",
    "\n",
    "    summary = pd.DataFrame(\n",
    "        {\n",
    "            \"model\": [\"GARCH\", \"EGARCH\"],\n",
    "            \"AIC\": [garch_fit.aic, egarch_fit.aic],\n",
    "            \"BIC\": [garch_fit.bic, egarch_fit.bic],\n",
    "            \"backtest_QLIKE\": [\n",
    "                qlike(bt_garch[\"realized_variance\"].values, bt_garch[\"forecast_variance\"].values),\n",
    "                qlike(bt_egarch[\"realized_variance\"].values, bt_egarch[\"forecast_variance\"].values),\n",
    "            ],\n",
    "            \"backtest_MSE\": [\n",
    "                mse(bt_garch[\"realized_variance\"].values, bt_garch[\"forecast_variance\"].values),\n",
    "                mse(bt_egarch[\"realized_variance\"].values, bt_egarch[\"forecast_variance\"].values),\n",
    "            ],\n",
    "        }\n",
    "    )\n",
    "    summary.to_csv(RESULTS_DIR / f\"{tag}_summary.csv\", index=False)\n",
    "    print(summary.to_string(index=False))\n",
    "\n",
    "\n",
    "def main() -> None:\n",
    "    parser = argparse.ArgumentParser(description=\"GARCH vs EGARCH volatility forecasting\")\n",
    "    parser.add_argument(\"--tickers\", nargs=\"+\", default=list(TICKERS.keys()), help=\"Ticker symbols, e.g. ^FCHI ^GSPC\")\n",
    "    parser.add_argument(\"--start\", default=\"2015-01-01\", help=\"Start date (YYYY-MM-DD)\")\n",
    "    parser.add_argument(\"--window\", type=int, default=1000, help=\"Rolling estimation window (trading days)\")\n",
    "    parser.add_argument(\"--horizon\", type=int, default=250, help=\"Number of out-of-sample forecast steps\")\n",
    "    parser.add_argument(\"--dist\", default=\"t\", help=\"Error distribution: 'normal', 't', 'skewt'\")\n",
    "    args, _unknown = parser.parse_known_args()\n",
    "\n",
    "    for ticker in args.tickers:\n",
    "        run(ticker, start=args.start, window=args.window, horizon=args.horizon, dist=args.dist)\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  }
 ],
